# Rust — the workspace target, plus the pre-workspace one that old checkouts
# may still carry
/target/
/src-tauri/target/

# Tauri code generation
/src-tauri/gen/

# Manual verification artifacts (screenshots, window dumps, app logs)
/.verify/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs & temp
*.log
*.tmp
tmp/

# Local environment / secrets
.env
.env.*
!.env.example
.envrc

# What the Pages workflow assembles, and what
# scripts/make-character-gallery.py writes when it is run with no --out. A
# copy of the shipped art, so committing it would duplicate every frame.
/_site/

# Python
__pycache__/
*.py[cod]

# Python virtual environments (the pet importer's Pillow lives in one)
.venv/

# Isolated git worktrees for feature work. Checkouts of this repository, so
# committing one would nest a clone inside itself.
.worktrees/

# Superpowers implementation plans are session scratch. A decision that
# has to last goes in docs/adr/, CONTEXT.md, README.md, AGENTS.md, or
# docs/SPEC.md.
docs/superpowers/

# Claude Code's working directory: local settings, and the throwaway worktrees
# subagents are given. Those worktrees are checkouts of this repository, so
# committing one would nest a clone inside itself.
#
# Everything inside it rather than the directory itself, so `!` can take one
# path back. An ignore that lists what to skip goes stale the moment the tool
# adds something new, so the default is still to skip all of it.
#
# `skills` and `agents` are the exceptions. Both are symlinks into `.agents/`,
# which is where the bytes actually live, and Claude Code reads them from
# nowhere else. An ignored symlink would not exist for a fresh clone. No
# trailing slash on either: git tracks a symlink as a blob, not a directory.
# `settings.json` is shared; `settings.local.json` stays personal.
.claude/*
!.claude/skills
!.claude/agents
!.claude/settings.json

# A dependency install is derived from a manifest, never committed, wherever it
# lands. The pstack tools under `.agents/skills/*/scripts/` install theirs on
# first use, and `watch-pr` alone pulls 37M the moment an agent reads a pull
# request's status. The app and the verify tool may grow their own.
# Manifests and lockfiles stay tracked; only what they produce is ignored.
node_modules/
