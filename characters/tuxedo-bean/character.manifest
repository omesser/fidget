# Source rows are documented in DEVELOPMENT.md; importer indices start at zero.
# All nine source loops are retained: a seated idle with four idle variants.

name = "Tuxedo Bean"
render_mode = "smooth"
scale = 1

[source]
art = "Tuxedo Bean, cut from the petscodex (petdex) pet `tuxedo-bean` by scripts/import-pet.py. A tiny velvet tuxedo cat with bright amber eyes and pristine white socks. Bean keeps calm company, naps a lot, and chases the cursor when the mood takes it."
url = "https://petscodex.com/pets/tuxedo-bean"
license = "MIT for these frames as cut and arranged here, along with the personality prose and the manifest. The art those frames adapt is not: it declares no license anywhere in the source ecosystem, and the importer warned so."

[director]
model_base = 2
model_power = 1

[cursor]
near_reaction = "face"
rush_reaction = "react"

[animations.idle]
frames = [
  "frames/idle-0.png",
  "frames/idle-1.png",
  "frames/idle-2.png",
  "frames/idle-3.png",
  "frames/idle-4.png",
  "frames/idle-5.png",
]
fps = 3
weight = 80

[animations.look-around]
frames = [
  "frames/look-around-0.png",
  "frames/look-around-1.png",
  "frames/look-around-2.png",
  "frames/look-around-3.png",
  "frames/look-around-4.png",
  "frames/look-around-5.png",
]
fps = 3
variant_of = "idle"
weight = 10

[animations.nod-off]
frames = [
  "frames/nod-off-0.png",
  "frames/nod-off-1.png",
  "frames/nod-off-2.png",
  "frames/nod-off-3.png",
  "frames/nod-off-4.png",
  "frames/nod-off-5.png",
  "frames/nod-off-6.png",
  "frames/nod-off-7.png",
]
fps = 4
variant_of = "idle"
weight = 4

[animations.review]
frames = [
  "frames/review-0.png",
  "frames/review-1.png",
  "frames/review-2.png",
  "frames/review-3.png",
  "frames/review-4.png",
  "frames/review-5.png",
]
fps = 4
variant_of = "idle"
weight = 3

[animations.wave]
frames = [
  "frames/wave-0.png",
  "frames/wave-1.png",
  "frames/wave-2.png",
  "frames/wave-3.png",
]
fps = 4
variant_of = "idle"
weight = 3

[animations.walk]
frames = [
  "frames/walk-0.png",
  "frames/walk-1.png",
  "frames/walk-2.png",
  "frames/walk-3.png",
  "frames/walk-4.png",
  "frames/walk-5.png",
  "frames/walk-6.png",
  "frames/walk-7.png",
]
fps = 9

[animations.walk-left]
frames = [
  "frames/walk-left-0.png",
  "frames/walk-left-1.png",
  "frames/walk-left-2.png",
  "frames/walk-left-3.png",
  "frames/walk-left-4.png",
  "frames/walk-left-5.png",
  "frames/walk-left-6.png",
  "frames/walk-left-7.png",
]
fps = 9
left_of = "walk"

[animations.talk]
frames = [
  "frames/talk-0.png",
  "frames/talk-1.png",
  "frames/talk-2.png",
  "frames/talk-3.png",
  "frames/talk-4.png",
  "frames/talk-5.png",
]
fps = 4

[animations.jump]
frames = [
  "frames/jump-0.png",
  "frames/jump-1.png",
  "frames/jump-2.png",
  "frames/jump-3.png",
  "frames/jump-4.png",
]
fps = 6
loop = "once"

[animations.fall]
frames = [
  "frames/jump-2.png",
  "frames/jump-3.png",
]
fps = 5

[animations.land]
frames = [
  "frames/jump-3.png",
  "frames/jump-4.png",
]
fps = 5
loop = "once"

# Perched on a window or held, Bean just sits there, so hold reuses idle.
[animations.hold]
frames = [
  "frames/idle-0.png",
  "frames/idle-1.png",
  "frames/idle-2.png",
  "frames/idle-3.png",
  "frames/idle-4.png",
  "frames/idle-5.png",
]
fps = 3

[animations.react]
frames = [
  "frames/wave-0.png",
  "frames/wave-1.png",
  "frames/wave-2.png",
  "frames/wave-3.png",
]
fps = 4
loop = "once"

[animations.sit]
frames = [
  "frames/idle-0.png",
]
fps = 1

# The sheet has no sleep loop. The lowest nod-off pose, head down, supplies quiet rest.

[animations.sleep]
frames = [
  "frames/nod-off-5.png",
]
fps = 1

[behaviors.keep-company]
play = ["idle"]
weight = 50

[behaviors.chat]
play = ["talk", "idle"]
weight = 15
when = "idle under 1m"

[behaviors.greet]
play = ["react"]
then = "keep-company"
weight = 20
when = "idle under 10s"

[behaviors.prowl]
play = ["walk", "idle"]
weight = 20
when = "idle over 30s"

# Row 4's pounce, crouch to landing, on its own now and then.

[behaviors.jump]
play = ["jump"]
weight = 5
when = "idle over 30s"

[behaviors.nap]
play = ["sit", "sleep"]
weight = 40
when = "idle over 5m"

[behaviors.wave]
play = ["react"]
weight = 0

# The left strip, drawn facing left.
[frame_facing]
"frames/walk-left-0.png" = "left"
"frames/walk-left-1.png" = "left"
"frames/walk-left-2.png" = "left"
"frames/walk-left-3.png" = "left"
"frames/walk-left-4.png" = "left"
"frames/walk-left-5.png" = "left"
"frames/walk-left-6.png" = "left"
"frames/walk-left-7.png" = "left"
