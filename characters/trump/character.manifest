# A chibi Trump pet, imported from petscodex (petdex).

name = "Trump"
render_mode = "smooth"
scale = 1

[source]
art = """
Cut from the petscodex pet `trump`, and hand-modified."""
url = "https://petscodex.com/pets/trump"
license = """
MIT for the package — prose, manifest, and the frames as arranged here. The \
art they adapt is not: the petscodex pet `trump`, which declares no license."""

# Proactive model calls: Trump treats the desk as a rally, so the wait
# does not grow. One and one keeps every two minutes.

[director]
model_base = 1
model_power = 1

# Cursor reactions: attention-seeking and engaging, talks to and approaches everything.
[cursor]
near_reaction = "speak"
rush_reaction = "toward"

# The quiet stand and the folded-arm wait share the idling, three to two.
[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 4
weight = 30

[animations.waiting]
frames = ["frames/waiting-0.png", "frames/waiting-1.png", "frames/waiting-2.png", "frames/waiting-3.png", "frames/waiting-4.png", "frames/waiting-5.png"]
fps = 4
weight = 20
variant_of = "idle-gesture"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 8

# The mouth moves open, shut, open, open, so a reply reads as speech.
[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png"]
fps = 5
weight = 30

# A greeting is a talk, and one talk in four is a wave instead.
# wave-1 and wave-2 are rescaled to wave-0's hair so the wave holds size.
[animations.wave]
frames = ["frames/wave-0.png", "frames/wave-1.png", "frames/wave-2.png"]
fps = 4
variant_of = "talk"
weight = 10

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/idle-0.png"]
fps = 6
loop = "once"

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 4

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png", "frames/react-5.png"]
fps = 4
loop = "once"

# Perched draws sit. Crossed arms, cut at the waist — a desk, not a nap.
[animations.sit]
frames = ["frames/react-4.png"]
fps = 1

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png", "frames/sleep-2.png"]
fps = 2
loop = "once"

# A rally on the desk. Greets whoever is at the keyboard, keeps talking
# for a minute, sits once they have gone, and sleeps when the room is
# quiet. Walk stays light: he would rather speak than patrol.

[behaviors.greet]
play = ["talk"]
then = "report"
weight = 40
when = "idle under 10s"

[behaviors.report]
play = ["talk", "idle", "talk"]
weight = 40
when = "idle under 1m"

[behaviors.fidget]
play = ["idle"]
weight = 20
when = "idle over 10s"

[behaviors.settle]
play = ["sit"]
then = "doze"
weight = 30
when = "idle over 1m"

[behaviors.doze]
play = ["sleep"]
weight = 50
when = "idle over 2m"

[behaviors.walk]
play = ["walk"]
weight = 10
when = "idle over 30s"

[behaviors.patrol]
play = ["walk", "talk", "walk"]
then = "walk"
weight = 20
when = "idle over 2m"

# Rare on purpose: below every other weight in this file.
[behaviors.jump]
play = ["jump"]
weight = 3
when = "idle over 30s"

[behaviors.waiting]
play = ["waiting"]
weight = 0
when = "idle over 10s"
