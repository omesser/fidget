# BMO from Pendleton Ward's Adventure Time. Based on the shimejishop free pack.

name = "BMO"
render_mode = "smooth"
scale = 1

[source]
art = """
BMO from Adventure Time, cut from the free BMO shimeji pack on shimejishop, \
and slightly modified."""
url = "https://shimejishop.com/free/bmo-shimeji/"
license = """
MIT for the package — prose, manifest, and the frames as arranged here. The \
art they adapt is not: the free BMO shimeji pack on shimejishop, which \
declares no license. BMO is Cartoon Network IP."""

# Proactive model calls: BMO offers to help before being asked, so the wait
# does not grow. One and one keeps every two minutes.

[director]
model_base = 1
model_power = 1

# Cursor reactions: friendly and helpful, greets but is surprised by sudden approaches.
[cursor]
near_reaction = "speak"
rush_reaction = "react"

# The idle is a calm stand; the singing and the skateboard ride its ring as
# variants. The sit is the pack's self-play set: four games on its own screen.

# Singing and skateboarding are whole-body performances, so the stand takes
# the idling weighed eight times either of them.
[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 1
weight = 80

[animations.sing]
frames = ["frames/sing-0.png", "frames/sing-1.png", "frames/sing-2.png", "frames/sing-3.png"]
fps = 3
variant_of = "idle"

# Cruise, push, cruise, cheer — the bail frame stays in the pack: a board
# that vanishes mid-loop reads as a glitch, not a trick.
[animations.skate]
frames = ["frames/skate-0.png", "frames/skate-1.png", "frames/skate-0.png", "frames/skate-2.png"]
fps = 3
variant_of = "idle"

# Dribbling the whole way is a mood rather than the usual walk: three plain
# walks to each one that goes out with the football.
[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-1.png"]
fps = 8
weight = 30

[animations.ballwalk]
frames = ["frames/ballwalk-0.png", "frames/ballwalk-1.png"]
fps = 5
variant_of = "walk"

# Climbing is optional, scaling a display edge; a package without it climbs in
# its walk art. BMO draws its own.

[animations.climb]
frames = ["frames/climb-0.png", "frames/climb-1.png", "frames/climb-2.png"]
fps = 4

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 8
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 1

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 4

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 10
loop = "once"

# Possession start plays this, or `react` when a package draws none. The
# pack's split flash: the screen breaks, then blanks.
[animations.possessed]
frames = ["frames/possessed-0.png", "frames/possessed-1.png"]
fps = 6

# Gesture and rest: talking hands, standing up. The pack's grinning
# lean-back frames read as sitting and were mistaken for the sit.
[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png"]
fps = 3

# BMO does not settle. Every Behavior here ends on its feet, which is what a
# Character who would rather be playing looks like from the outside: the sit and
# sleep art exists, and only the Engine's own idling ever reaches it.
#
# What BMO does with no model configured. The arc: say hello to whoever is at
# the keyboard, keep announcing for a minute after they stop in case anybody is
# still listening, and walk the desk once they have plainly gone. That last
# phase is still an active one — BMO does not settle, so being alone is a
# circuit to patrol rather than somewhere to sit down.
#
# The bands overlap rather than meeting at a point. Two conditions that met
# exactly at 10s would leave BMO with nothing eligible at that instant.
#
# Weights balance within a phase now, not across the whole day. `greet`
# outranks `report` in the seconds somebody is actually there, because a
# Character this pleased to see you says hello before it files a report;
# `report` outranks the fidgeting in the minute after they stop, which is the
# only stretch it still has an audience for. `walk` stays lightest: it is the
# bare Primitive, and `patrol` is the same walk with BMO looking at something.

# The react art is a wince, and it belongs to being poked or dropped — the
# engine plays it there on its own. Written into these Behaviors it fired on
# nearly every Director wake and read as BMO getting hurt mid-walk, so the
# pauses here are calm ones: standing or talking. Never sitting — no
# Behavior of BMO's settles, and the idle ring gives a plain stand its
# variety on its own.

[behaviors.walk]
play = ["walk"]
weight = 10
when = "idle over 30s"

[behaviors.patrol]
play = ["walk", "idle", "walk"]
then = "walk"
weight = 30
when = "idle over 2m"

[behaviors.fidget]
play = ["idle"]
weight = 20
when = "idle over 10s"

[behaviors.report]
play = ["talk", "idle", "talk"]
weight = 30
when = "idle under 1m"

[behaviors.greet]
play = ["talk"]
then = "patrol"
weight = 40
when = "idle under 10s"

# Zero until BMO has dedicated jump art: the fall it falls back on does not
# stand in for one. Still declared, so a Director can still ask for it. #490.
[behaviors.jump]
play = ["jump"]
weight = 0
when = "idle over 10s"
