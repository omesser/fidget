# Final Fantasy I's Black Mage. The voice is Black Mage Evilwizardington from
# Brian Clevinger's 8-Bit Theater (Nuklear Power).

name = "Black Mage"
scale = 3

[source]
art = """
Sliced from a custom sprite sheet by GigaGuy on \
The Spriters Resource (asset 17261). The voice is Black Mage \
Evilwizardington from Brian Clevinger's 8-Bit Theater (Nuklear Power)."""
license = """
MIT for the package — prose, manifest, and the frames as arranged here. The \
art they adapt is not: a custom sprite sheet by GigaGuy on The Spriters \
Resource, which declares no license. The Black Mage is Square Enix IP."""

# Proactive model calls: after each one with no one addressing the character,
# the wait becomes wait * model_base ^ model_power. Two and one doubles.

[director]
model_base = 2
model_power = 1

# Cursor reactions: antisocial and irritable, avoids attention and reacts with annoyance.
[cursor]
near_reaction = "away"
rush_reaction = "react"

[animations.idle]
frames = [
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-1.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-2.png",
]
fps = 1

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png"]
fps = 8

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = [
  "frames/land-0.png",
  "frames/land-1.png",
  "frames/land-2.png",
  "frames/land-3.png"
]
fps = 10
loop = "once"

[animations.sit]
frames = [
  "frames/sit-0.png",
  "frames/sit-1.png",
  "frames/sit-1.png",
  "frames/sit-2.png",
  "frames/sit-3.png",
  "frames/sit-3.png"
]
fps = 3

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 2

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 8
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png"]
fps = 3

# Greets by announcing himself, idles by seething, only powers down when
# nothing is left to insult. The arc: greet loud, stand idle most of the time,
# sit when idle persists, sleep deeply after long absence.

[behaviors.greet]
play = ["react", "talk"]
then = "ponder"
weight = 30
when = "idle under 10s"

[behaviors.ponder]
play = ["idle"]
weight = 40
when = "idle over 10s"

[behaviors.settle]
play = ["sit"]
then = "meditate"
weight = 30
when = "idle over 1m"

[behaviors.meditate]
play = ["sit", "sleep"]
weight = 50
when = "idle over 2m"

[behaviors.walk]
play = ["walk"]
weight = 10
when = "idle over 30s"

# The fall, and the land that opens with it, is drawn turned the other way from the rest.
[frame_facing]
"frames/fall-0.png" = "left"
"frames/fall-1.png" = "left"
"frames/land-0.png" = "left"
"frames/land-1.png" = "left"
