# A chibi Jotaro Kujo pet (from JoJo's Bizarre Adventure), imported from
# petscodex (petdex).

name = "Jotaro Kujo"
render_mode = "smooth"
scale = 1
facing = "left"

[source]
art = """
A chibi Jotaro Kujo pet, cut from the petscodex pet `jotaro-kujo`."""
url = "https://petscodex.com/pets/jotaro-kujo"
license = """
MIT for the package — prose, manifest, and the frames as arranged here. The \
art they adapt is not: the petscodex pet `jotaro-kujo`, which declares no \
license. Jotaro Kujo is Shueisha / Hirohiko Araki IP."""

# Cursor reactions: cool and unfazed, doesn't react to proximity but faces challenges.

[cursor]
near_reaction = "indifferent"
rush_reaction = "face"

# Doubling the ambient wait suits someone who speaks only when speaking is
# shorter than not speaking.

[director]
model_base = 2
model_power = 1

# The two stands differ by a coat-flick, and Jotaro's whole register is not
# moving, so the stand is weighed three times the wait:
# a quarter of it is as much shifting about as he does.
[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 2
weight = 30

[animations.waiting]
frames = ["frames/waiting-0.png", "frames/waiting-1.png"]
fps = 2
variant_of = "idle"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 8

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png", "frames/talk-4.png", "frames/talk-5.png"]
fps = 6

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 6
loop = "once"

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 6

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png", "frames/react-5.png", "frames/react-6.png", "frames/react-7.png"]
fps = 7
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 2

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

# Jotaro is still, and this table says so. Standing is most of what he does;
# the walk is hands in pockets rather than a patrol; talking is rationed. The
# arc: a flat acknowledgement for whoever turned up, long stretches upright,
# sitting down to watch once they have stopped typing, and lying down — cap
# on — when the desk has plainly emptied.
#
# `greet` sits at the floor weight because he does not make an occasion of
# anyone arriving, and `mutter` matches it: two Behaviors that open his mouth,
# both rare, against a `stand` weighed five times either. The bands overlap so
# no instant of the day leaves him nothing he may do.

[behaviors.greet]
play = ["talk"]
weight = 10
when = "idle under 10s"

[behaviors.stand]
play = ["idle"]
weight = 50
when = "idle over 10s"

[behaviors.mutter]
play = ["talk"]
weight = 10
when = "idle over 30s"

[behaviors.walk]
play = ["walk"]
weight = 20
when = "idle over 30s"

[behaviors.watch]
play = ["sit"]
then = "stand"
weight = 40
when = "idle over 1m"

[behaviors.rest]
play = ["sit", "sleep"]
weight = 30
when = "idle over 2m"

# Only the walk faces right; every other pose leans left.
[frame_facing]
"frames/walk-0.png" = "right"
"frames/walk-1.png" = "right"
"frames/walk-2.png" = "right"
"frames/walk-3.png" = "right"
"frames/walk-4.png" = "right"
"frames/walk-5.png" = "right"
"frames/walk-6.png" = "right"
"frames/walk-7.png" = "right"
