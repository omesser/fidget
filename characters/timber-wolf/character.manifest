  "frames/sleep-14.png",
  "frames/sleep-15.png",
  "frames/sleep-16.png",
  "frames/sleep-17.png",
  "frames/sleep-18.png",
  "frames/sleep-19.png",
  "frames/sleep-20.png",
  "frames/sleep-21.png",
  "frames/sleep-22.png",
