# Timber Wolf (Mad Cat) OmniMech from Battletech.

name = "Timber Wolf"
render_mode = "smooth"
scale = 1

[source]
art = """
The Timber Wolf (Mad Cat) OmniMech from BattleTech, derived \
from a Sketchfab viewer recording of Clan's Timberwolf Battlemech by \
Yeoh Kher En / MekaRamen (https://mekaramen.com/, \
https://sketchfab.com/MekaRamen). Permission granted by the creator \
to use the derived frames in Fidget."""
url = "https://sketchfab.com/3d-models/clans-timberwolf-battlemech-74e4d72e0cf3409ba3992cd0d895bc2f"
license = """
Mixed. The frames are derived with permission granted for use in Fidget. \
The personality prose and the manifest are MIT. The Timber Wolf is also \
BattleTech IP."""

# Cursor reactions: a patrol mech acquires the contact rather than closing on
# it — the cursor gets tracked, and a rush at the chassis earns a weapon raise.

[cursor]
near_reaction = "face"
rush_reaction = "react"

# Proactive model calls: a combat mech patrols and reports. One and one
# keeps every two minutes.

[director]
model_base = 1
model_power = 1

# Camera-facing stand from the turn recording, so idle meshes with talk and react.
# Stand. TAC laser is an idle variant (below), and the stand is weighed three
# times the sweep.
[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 2
weight = 30

# Side stride, facing right for engine mirroring. 20 unique poses, 8 fps.
[animations.walk]
frames = [
  "frames/walk-0.png",
  "frames/walk-1.png",
  "frames/walk-2.png",
  "frames/walk-3.png",
  "frames/walk-4.png",
  "frames/walk-5.png",
  "frames/walk-6.png",
  "frames/walk-7.png",
  "frames/walk-8.png",
  "frames/walk-9.png",
  "frames/walk-10.png",
  "frames/walk-11.png",
  "frames/walk-12.png",
  "frames/walk-13.png",
  "frames/walk-14.png",
  "frames/walk-15.png",
  "frames/walk-16.png",
  "frames/walk-17.png",
  "frames/walk-18.png",
  "frames/walk-19.png",
]
fps = 8

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 8
loop = "once"

# A mech does not sit; it hunkers down on its legs.
[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png"]
fps = 2

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 4

# The mech never sleeps. Garrison is a point-scan / threaten loop (engine key stays sleep).
[animations.sleep]
frames = [
  "frames/sleep-0.png",
  "frames/sleep-1.png",
  "frames/sleep-2.png",
  "frames/sleep-3.png",
