# Timber Wolf (Mad Cat) OmniMech from Battletech.

name = "Timber Wolf"
render_mode = "smooth"
scale = 1

[source]
art = """
The Timber Wolf (Mad Cat) OmniMech from BattleTech, derived \
from a Sketchfab viewer recording of Clan's Timberwolf Battlemech by \
Yeoh Kher En / MekaRamen (https://mekaramen.com/, \
https://sketchfab.com/MekaRamen). Permission granted by the creator \
to use the derived frames in Fidget."""
url = "https://sketchfab.com/3d-models/clans-timberwolf-battlemech-74e4d72e0cf3409ba3992cd0d895bc2f"
license = """
Mixed. The frames are derived with permission granted for use in Fidget. \
The personality prose and the manifest are MIT. The Timber Wolf is also \
BattleTech IP."""

# Cursor reactions: a patrol mech acquires the contact rather than closing on
# it — the cursor gets tracked, and a rush at the chassis earns a weapon raise.

[cursor]
near_reaction = "face"
rush_reaction = "react"

# Proactive model calls: a combat mech patrols and reports. One and one
# keeps every two minutes.

[director]
model_base = 1
model_power = 1

# Camera-facing stand from the turn recording, so idle meshes with talk and react.
# Stand. TAC laser is an idle variant (below), and the stand is weighed three
# times the sweep.
[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 2
weight = 30

# Side stride, facing right for engine mirroring. 20 unique poses, 8 fps.
[animations.walk]
frames = [
  "frames/walk-0.png",
  "frames/walk-1.png",
  "frames/walk-2.png",
  "frames/walk-3.png",
  "frames/walk-4.png",
  "frames/walk-5.png",
  "frames/walk-6.png",
  "frames/walk-7.png",
  "frames/walk-8.png",
  "frames/walk-9.png",
  "frames/walk-10.png",
  "frames/walk-11.png",
  "frames/walk-12.png",
  "frames/walk-13.png",
  "frames/walk-14.png",
  "frames/walk-15.png",
  "frames/walk-16.png",
  "frames/walk-17.png",
  "frames/walk-18.png",
  "frames/walk-19.png",
]
fps = 8

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 8
loop = "once"

# A mech does not sit; it hunkers down on its legs.
[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png"]
fps = 2

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 4

# The mech never sleeps. Power-down is a slow torso twist on station.
[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1


# TAC laser sweep as an idle variant. scan-0.png is a byte-copy of idle-0 and
# is omitted; the real sweep is scan-1..3. One idling in four: the sweep is a
# mech checking its arc, which is worth seeing and not worth watching. A
# perched rest or the floor plays the whole 1s sweep; a Behavior's idle
# Primitive restarts the clock every 600ms, so it shows the way out and not
# the way back.
[animations.scan]
frames = [
  "frames/scan-1.png",
  "frames/scan-2.png",
  "frames/scan-3.png",
  "frames/scan-2.png",
]
fps = 4
variant_of = "idle"

# Full-frontal weapon raise from the turn recording: contact acquired.
[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 8
loop = "once"

# Camera-facing report: the torso and arms carry the gesture.
[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png"]
fps = 4

# A heavy assault mech's life: patrol, report, engage. Scan is idle's variant
# only — no sit bake, no scan Behavior.

[behaviors.patrol]
play = ["walk", "idle", "walk"]
weight = 30
when = "idle over 30s"

[behaviors.report]
play = ["talk", "idle"]
weight = 30
when = "idle under 2m"

[behaviors.engage]
play = ["idle", "react", "idle"]
weight = 20
when = "idle over 2m"

[behaviors.standby]
play = ["sit"]
then = "power_down"
weight = 20
when = "idle over 3m"

[behaviors.power_down]
play = ["sit", "sleep"]
weight = 40
when = "idle over 5m"

[behaviors.pursue]
play = ["chase"]
weight = 30
when = "idle over 30s"

# Asleep, the cockpit points left.
[frame_facing]
"frames/sleep-0.png" = "left"
"frames/sleep-1.png" = "left"
